# Plantilla de despliegue Docker (estructura DevOps). Copiar a environments/.env
# y ajustar. La contraseña de Postgres NO va acá — vive en ../secrets/db_password.txt
# y se inyecta a los contenedores vía POSTGRES_PASSWORD_FILE.
#
# Levantar con:
#   docker compose -f db_services/basededatos.yml --env-file environments/.env up -d
#   docker compose --env-file environments/.env up -d --build

# Postgres — el hostname es el nombre del contenedor (red Docker), no localhost.
POSTGRES_USER=jac
POSTGRES_DB=jac_showroom
DB_HOST=db-showroom
PORT_DB_HOST=5432
# Debe coincidir con el contenido de ../secrets/db_password.txt.
DATABASE_URL="postgresql://jac:cambiar-por-una-contrasena-segura@db-showroom:5432/jac_showroom?schema=public"

# Puerto publicado del contenedor web.
PORT_WEB=4000

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-un-secreto-real"
AUTH_TRUST_HOST="true"

# Primer usuario del panel (lo crea `npm run db:seed`; cambiar la contraseña
# tras el primer login).
SEED_ADMIN_EMAIL="admin@jac.com.ve"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="cambiar-antes-de-seed"

# ——— Worker de assets 360° (servicio `worker` de docker-compose) ———
# Días de gracia antes de que la purga diaria borre un vehículo ARCHIVED y
# sus archivos.
ARCHIVE_GRACE_DAYS=30
# Cuánta máquina puede comerse el worker mientras comprime. En el VPS
# comparte host con la web, así que estos topes existen para que el sitio
# público no se caiga durante un procesamiento. Con cores de sobra, subir
# WORKER_CPUS y WORKER_SHARP_CONCURRENCY acelera las subidas.
WORKER_CPUS=1.5
WORKER_MEMORY=1g
WORKER_SHARP_CONCURRENCY=2
WORKER_UV_THREADPOOL_SIZE=4

# Storage S3-compatible (R2/S3) — las 4 deben estar definidas o ninguna
# (si ninguna, cae a disco local en /app/uploads-data).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="jac-showroom"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ——— CRM Odoo (envío de leads — servicio `showroom`) ———
# Integración por JSON-RPC contra ${ODOO_URL}/jsonrpc. La API Key se genera en
# Odoo: avatar → Mis preferencias → Seguridad de la cuenta → Nueva clave API.
# NO es la contraseña del login web — y como es un secreto de verdad, este
# archivo NO se commitea (está en .gitignore); en el VPS se edita a mano.
#
# ODOO_ENABLED=false deja el envío en modo mock sin tocar Odoo. Se pone en true
# recién cuando ODOO_API_KEY tenga la clave real, para no desplegar con la
# integración a medias: el lead se persiste igual en la DB y queda reintentable
# desde /admin/leads.
ODOO_ENABLED=false
ODOO_URL="https://odoo.bel.com.ve"
ODOO_DB="bel_odoo"
ODOO_USER="showroom"
ODOO_API_KEY=""
# Equipo de ventas al que se asignan las oportunidades. Vacío = Odoo aplica sus
# propias reglas de asignación.
# ODOO_TEAM_ID=
