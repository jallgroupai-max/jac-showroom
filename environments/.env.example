# Plantilla de despliegue Docker (estructura DevOps). Copiar a environments/.env
# y ajustar. La contraseña de Postgres NO va acá — vive en ../secrets/db_password.txt
# y se inyecta a los contenedores vía POSTGRES_PASSWORD_FILE.
#
# Levantar con:
#   docker compose -f db_services/basededatos.yml --env-file environments/.env up -d
#   docker compose --env-file environments/.env up -d --build

# Postgres — el hostname es el nombre del contenedor (red Docker), no localhost.
POSTGRES_USER=jac
POSTGRES_DB=jac_showroom
DB_HOST=db-showroom
PORT_DB_HOST=5432
# Debe coincidir con el contenido de ../secrets/db_password.txt.
DATABASE_URL="postgresql://jac:cambiar-por-una-contrasena-segura@db-showroom:5432/jac_showroom?schema=public"

# Puerto publicado del contenedor web.
PORT_WEB=4000

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-un-secreto-real"
AUTH_TRUST_HOST="true"

# Primer usuario del panel (lo crea `npm run db:seed`; cambiar la contraseña
# tras el primer login).
SEED_ADMIN_EMAIL="admin@jac.com.ve"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="cambiar-antes-de-seed"

# Storage S3-compatible (R2/S3) — las 4 deben estar definidas o ninguna
# (si ninguna, cae a disco local en /app/uploads-data).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="jac-showroom"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
