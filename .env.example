# Copiar a .env y ajustar. Ningún valor de este archivo es secreto real.

# PostgreSQL local: `docker compose up -d postgres` (docker-compose.yml).
# POSTGRES_PORT controla el puerto publicado — cambiarlo si el 5432 ya está
# ocupado por otro Postgres, y reflejarlo en DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://jac:jac_dev@localhost:5432/jac_showroom"

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-un-secreto-real"
# Necesario fuera de Vercel (dev local, Docker) para que Auth.js confíe en el host.
AUTH_TRUST_HOST="true"

# Primer usuario del panel (lo crea `npm run db:seed`; cambiar la contraseña
# tras el primer login).
SEED_ADMIN_EMAIL="admin@jac.com.ve"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="cambiar-antes-de-seed"

# Storage S3-compatible (R2/S3) — se usa a partir de la Fase A2.
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="jac-showroom"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ——— CRM Odoo (envío de leads — src/lib/crm.ts, /api/leads) ———
# Integración por JSON-RPC contra ${ODOO_URL}/jsonrpc. La API Key se genera en
# Odoo: avatar → Mis preferencias → Seguridad de la cuenta → Nueva clave API.
# NO es la contraseña del login web.
#
# Con ODOO_ENABLED=false el envío usa el mock y NO toca Odoo — útil en dev para
# no ensuciar el CRM con leads de prueba. El lead se persiste igual en la DB y
# queda reintentable desde /admin/leads, así que apagarlo no pierde nada.
ODOO_ENABLED=false
ODOO_URL="https://odoo.bel.com.ve"
ODOO_DB="bel_odoo"
ODOO_USER="showroom"
ODOO_API_KEY=""
# Equipo de ventas al que se asignan las oportunidades. Vacío = Odoo aplica sus
# propias reglas de asignación.
# ODOO_TEAM_ID=
